{
  "include": ["$(MODDABLE)/examples/manifest_mod.json"],
  "modules": {
    "*": ["./mod", "./bridge-core"],
    "tars-http-server-service": "./http-server-service",
    "tars-listen": "./listen"
  },
  "config": {
    "tarsStackchan": {
      "token": "replace-with-local-token",
      "port": 80,
      "device": "stackchan-k151",
      "firmware": "tars-stackchan-dev",
      "ledName": "head",
      "speechPathPrefix": "/api/tts?text="
    }
  }
}
