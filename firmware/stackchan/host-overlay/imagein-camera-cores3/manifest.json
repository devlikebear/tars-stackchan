{
	"build": {
		"SDKCONFIGPATH": "./sdkconfig-combined"
	},
	"preload": [
		"embedded:io/image/in/camera"
	],
	"platforms": {
		"esp32": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./camera"
			},
			"dependency": [
				{
					"name": "esp_video",
					"version": "^2.1.0",
					"includes": [
						"include"
					]
				},
				{
					"name": "esp32-camera",
					"version": "^2.0.10",
					"includes": [
						"driver/include",
						"conversions/include"
					]
				},
				{
					"name": "esp_jpeg",
					"version": "^1.3.1"
				},
				{ "idf": "esp_driver_i2c" },
				{ "idf": "esp_driver_cam" }
			]
		}
	}
}
